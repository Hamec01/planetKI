# Godot 4 .gitignore

# Godot-specific ignores
.godot/
*.import
*.uid
export_presets.cfg

# System / IDE ignores
.DS_Store
Thumbs.db
*.tmp
*.log
.vscode/
.idea/
__pycache__/
*.pyc

# Спрайты, тайлы и манифесты Composer теперь хранятся в репозитории (проект запускается из клона).
# Импорт-кэш Godot (*.import, .godot/) пересоздаётся редактором и не хранится.
*.wav
*.ogg
*.mp3
*.flac
*.tga
*.psd
*.aseprite
*.zip
*.tar.gz

# Отладочные скрипты и сборки
scratch/
build/
